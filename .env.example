# SFT Trading Dataset — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Optional: Twitter/X Bearer Token for real KOL tweet fetching
# Requires Elevated or Academic access. Respect Twitter ToS — no bulk scraping.
# If not set, the pipeline falls back to bundled sample data (--demo mode).
TWITTER_BEARER_TOKEN=

# Optional: Anthropic API key for LLM-assisted reasoning expansion
# Used by transform/to_sft.py to expand terse tweets into well-formed reasoning.
# If not set, a deterministic template fallback is used instead.
ANTHROPIC_API_KEY=
